# Caddy in front of Kohaku (docker-compose.yml): TLS and forwarding only. Security headers,
# limits and validation ship in the Kohaku image, never here.
{
	{$KOHAKU_CADDY_CI}
	# Certificates for project domains only when Kohaku says the name is one.
	on_demand_tls {
		ask http://kohaku:8080/.well-known/kohaku/tls-ask
	}
}

{$KOHAKU_DOMAIN} {
	respond /.well-known/kohaku/* 404
	reverse_proxy kohaku:8080
}

https:// {
	tls {
		on_demand
	}
	respond /.well-known/kohaku/* 404
	reverse_proxy kohaku:8080
}
