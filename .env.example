# Kohaku settings for Docker Compose. Copy to .env, run `chmod 600 .env` (it holds your
# secrets) and fill in every value. Kohaku refuses to start while a value is still the
# example below. Configuration reference: README.md, "Configuration".

# Your main domain; its DNS records must point at this server. Kohaku runs at
# https://<this domain>, and Caddy gets the certificate for it.
KOHAKU_DOMAIN=bugs.example.com

# Instance secret. Generate it once with `head -c 32 /dev/urandom | base64` and keep a
# copy apart from your backups: a backup only starts with the secret it was made with.
KOHAKU_SECRET=

# Mail goes through your provider's SMTP server, always over verified TLS.
KOHAKU_SMTP_HOST=smtp.example.com
# 587 with starttls, or 465 with implicit.
KOHAKU_SMTP_PORT=587
KOHAKU_SMTP_TLS=starttls
KOHAKU_SMTP_USERNAME=your-smtp-username
# Keep the single quotes so Compose takes the password literally (it cannot contain ').
KOHAKU_SMTP_PASSWORD=''
# Sender address of every mail Kohaku sends.
KOHAKU_SMTP_FROM=bugs@example.com

# Optional: mails per hour that unauthenticated requests may cause, instance-wide.
# KOHAKU_PUBLIC_MAIL_PER_HOUR=60
