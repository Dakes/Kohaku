# Settings for trying the Compose stack on this machine (`just local`), not for a real
# server: that one starts from .env.example. Caddy serves https://localhost:8443 with its own
# local certificate authority. The SMTP values only pass validation; no mail is sent.
KOHAKU_DOMAIN=localhost
# Unprivileged ports, so rootless Docker can publish them: https://localhost:8443
KOHAKU_HTTP_PORT=8080
KOHAKU_HTTPS_PORT=8443
# `just local` fills in a random one.
KOHAKU_SECRET=
KOHAKU_SMTP_HOST=smtp.invalid.test
KOHAKU_SMTP_PORT=587
KOHAKU_SMTP_TLS=starttls
KOHAKU_SMTP_USERNAME=local
KOHAKU_SMTP_PASSWORD='unused'
KOHAKU_SMTP_FROM=kohaku@localhost
# Caddy's local CA stays out of this machine's trust store.
KOHAKU_CADDY_CI=skip_install_trust
